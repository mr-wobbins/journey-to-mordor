# Neon Postgres — use the pooled connection string for the app runtime
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Neon direct (non-pooled) URL — used by Prisma migrations via prisma.config.ts
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Cookie signing (≥ 32 characters). Generate with: openssl rand -base64 32
SESSION_SECRET="replace-with-a-long-random-secret"

# Strava API app — https://www.strava.com/settings/api
STRAVA_CLIENT_ID=""
STRAVA_CLIENT_SECRET=""

# Must match Strava Authorization Callback Domain + path
# Local:  http://localhost:3000/api/auth/strava/callback
# Prod:   https://YOUR_PROJECT.vercel.app/api/auth/strava/callback
STRAVA_REDIRECT_URI="http://localhost:3000/api/auth/strava/callback"

# Public site URL (no trailing slash) — used for invite links
NEXT_PUBLIC_APP_URL="http://localhost:3000"
